{
  "title": "QuotePilot by MBMApps | Catering quotes and event operations",
  "headings": [
    {
      "level": 1,
      "text": "Every event is a document that won’t hold still."
    },
    {
      "level": 2,
      "text": "Morgan Wedding"
    },
    {
      "level": 2,
      "text": "Running a business means carrying all of it."
    },
    {
      "level": 2,
      "text": "One request. Every consequence in view."
    },
    {
      "level": 2,
      "text": "Your attention, protected"
    },
    {
      "level": 2,
      "text": "Complexity, carried"
    },
    {
      "level": 2,
      "text": "Time, returned"
    },
    {
      "level": 2,
      "text": "Your time is the one thing the business cannot replace."
    },
    {
      "level": 3,
      "text": "Begin with what the customer meant, not a blank form."
    },
    {
      "level": 3,
      "text": "Let one adjustment explain everything it touches."
    },
    {
      "level": 3,
      "text": "Carry the truth forward without carrying it alone."
    },
    {
      "level": 2,
      "text": "From inquiry to a prepared event"
    },
    {
      "level": 3,
      "text": "Capture the event"
    },
    {
      "level": 3,
      "text": "Build the offer"
    },
    {
      "level": 3,
      "text": "Review the numbers"
    },
    {
      "level": 3,
      "text": "Share the proposal"
    },
    {
      "level": 3,
      "text": "Prepare the handoff"
    },
    {
      "level": 2,
      "text": "Make the customer’s next decision feel simple."
    },
    {
      "level": 2,
      "text": "Let the team arrive prepared, not preoccupied."
    },
    {
      "level": 3,
      "text": "The next conversation"
    },
    {
      "level": 3,
      "text": "The day ahead"
    },
    {
      "level": 3,
      "text": "The people"
    },
    {
      "level": 3,
      "text": "The handoff"
    },
    {
      "level": 2,
      "text": "Five caterers will shape what this becomes."
    },
    {
      "level": 2,
      "text": "An app should make life easier."
    }
  ],
