{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence.local/schemas/task-packet.schema.json",
  "title": "Development Control Plane Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "objective",
    "nonObjectives",
    "risk",
    "workType",
    "requiredCapabilities",
    "intent",
    "scope",
    "context",
    "verification",
    "completionCriteria"
  ],
  "properties": {
    "schemaVersion": {"enum": [2, 3]},
    "id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACTIVE", "BLOCKED", "STAGED", "COMPLETED", "CANCELLED", "DEFERRED_WITH_AUTHORITY"]},
    "objective": {"type": "string", "minLength": 1},
    "nonObjectives": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "workType": {"type": "string", "minLength": 1},
    "requiredCapabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "journeys", "backlogItems", "successMetrics", "experiments"],
      "properties": {
        "requirements": {"type": "array", "items": {"type": "string"}},
        "journeys": {"type": "array", "items": {"type": "string"}},
        "backlogItems": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "successMetrics": {"type": "array", "items": {"type": "string"}},
        "experiments": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {"paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {"required": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "completionCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "authorityBoundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceRequired", "humanDecision", "decisionAuthority", "claimBoundary"],
      "properties": {
        "evidenceRequired": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "humanDecision": {"enum": ["REQUIRED", "NOT_REQUIRED"]},
        "decisionAuthority": {"type": "string", "minLength": 1},
        "claimBoundary": {"type": "string", "minLength": 1}
      }
    },
    "acceptanceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authority", "evidence"],
      "properties": {
        "decision": {"const": "ACCEPTED"},
        "authority": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "terminalDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "rationale"],
      "properties": {
        "authority": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "evidence": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": 3}}, "required": ["schemaVersion"]},
      "then": {"required": ["dependencies", "authorityBoundaries", "acceptance"]}
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {"const": 3},
          "status": {"const": "COMPLETED"}
        },
        "required": ["schemaVersion", "status"]
      },
      "then": {"required": ["acceptanceDecision"]}
    }
  ]
}
