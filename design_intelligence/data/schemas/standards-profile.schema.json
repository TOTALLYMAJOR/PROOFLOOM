{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence.local/schemas/standards-profile.schema.json",
  "title": "Repository Industry Standards Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "reviewedAt", "reviewAfter", "contexts", "standards"],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogVersion": {"type": "string", "minLength": 1},
    "reviewedAt": {"type": "string", "format": "date"},
    "reviewAfter": {"type": "string", "format": "date"},
    "contexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "applicability", "disposition", "rationale", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE"]},
          "disposition": {"enum": ["ADOPTED", "TAILORED", "NOT_APPLICABLE", "GAP"]},
          "rationale": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
