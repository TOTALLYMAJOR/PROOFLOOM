{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://totallymajor.local/schemas/baseline-review-request.schema.json",
  "title": "Baseline Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scenarioId",
    "product",
    "surface",
    "status",
    "requestedBy",
    "requestedAt",
    "promotionAuthority",
    "baselineMutationPerformed",
    "sourceRevision",
    "qaEvidence",
    "modelEvidence",
    "candidateRoot",
    "candidates",
    "blockers",
    "requiredHumanApprovals"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^BR-[A-F0-9]{16}$"},
    "scenarioId": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "minLength": 1},
    "status": {"enum": ["REVIEWABLE", "BLOCKED"]},
    "requestedBy": {"type": "string", "minLength": 1},
    "requestedAt": {"type": "string", "format": "date-time"},
    "promotionAuthority": {"const": "human-required"},
    "baselineMutationPerformed": {"const": false},
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "commitSha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "commitSha": {"type": "string", "pattern": "^[a-fA-F0-9]{7,64}$"}
      }
    },
    "qaEvidence": {"$ref": "#/$defs/qaEvidence"},
    "modelEvidence": {"$ref": "#/$defs/modelEvidence"},
    "candidateRoot": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/fileEvidence"}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "requiredHumanApprovals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "qaEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["PASS", "FAIL"]}
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "verdict", "severity"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "verdict": {"enum": ["PASS", "WARN", "FAIL"]},
        "severity": {"type": "string", "minLength": 1}
      }
    }
  }
}
