{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence.local/schemas/backlog-portfolio.schema.json",
  "title": "Whole Backlog Portfolio Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["completionPolicy", "sources", "terminalStatuses", "dependencies"],
  "properties": {
    "completionPolicy": {"const": "all-terminal"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "parser"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["active", "staged", "historical"]},
          "parser": {"enum": ["task-store", "markdown-checkboxes", "markdown-headings", "json-items"]},
          "includeInCompletion": {"type": "boolean"},
          "requireItems": {"type": "boolean"},
          "headingLevels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1, "maximum": 6}
          },
          "shadowedBy": {"type": "string", "minLength": 1}
        }
      }
    },
    "terminalStatuses": {
      "const": ["COMPLETED", "CANCELLED", "DEFERRED_WITH_AUTHORITY"]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    }
  }
}
