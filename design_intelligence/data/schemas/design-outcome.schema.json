{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence.local/schemas/design-outcome.schema.json",
  "title": "Design Outcome",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "decisionId", "result", "reason", "evidence", "lesson", "recordedAt"],
  "properties": {
    "id": {"type": "string", "pattern": "^DO-[A-Z0-9-]+$"},
    "decisionId": {"type": "string"},
    "result": {"enum": ["accepted", "rejected", "inconclusive"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "lesson": {"type": "string", "minLength": 1},
    "product": {"type": ["string", "null"]},
    "surface": {"type": ["string", "null"]},
    "component": {"type": ["string", "null"]},
    "recordedAt": {"type": "string", "format": "date-time"}
  }
}
