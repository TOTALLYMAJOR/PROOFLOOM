{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence.local/schemas/design-decision.schema.json",
  "title": "Design Decision Record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id", "status", "authorityLevel", "decision", "problem", "evidence", "alternatives",
    "reason", "affectedComponents", "createdAt"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^DL-[A-Z0-9-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["proposed", "accepted", "superseded", "deprecated", "rejected", "experimental"]},
    "authorityLevel": {"enum": ["portfolio", "archetype", "product", "surface", "component"]},
    "product": {"type": ["string", "null"]},
    "archetype": {"type": ["string", "null"]},
    "surface": {"type": ["string", "null"]},
    "component": {"type": ["string", "null"]},
    "category": {"type": "string"},
    "decision": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "alternatives": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "affectedComponents": {"type": "array", "items": {"type": "string"}},
    "supersedes": {"type": ["string", "null"]},
    "proposesSupersession": {"type": ["string", "null"]},
    "supersededBy": {"type": ["string", "null"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "validatedAt": {"type": ["string", "null"], "format": "date-time"},
    "reviewAfter": {"type": ["string", "null"], "format": "date"},
    "promotion": {
      "type": ["object", "null"],
      "properties": {
        "authorizedBy": {"type": "string", "minLength": 1},
        "outcomeId": {"type": "string", "minLength": 1},
        "validationEvidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
