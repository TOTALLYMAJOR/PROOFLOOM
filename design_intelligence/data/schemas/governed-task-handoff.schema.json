{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-intelligence.local/schemas/governed-task-handoff/2.0.0",
  "title": "Governed Task Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "handoffId", "createdAt", "repository", "objective", "authority", "tasks", "proof"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "kind": { "const": "design-intelligence/governed-task-handoff" },
    "handoffId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "snapshotSha256", "worktreeState"],
      "properties": {
        "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "snapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "worktreeState": { "const": "clean" },
        "remote": { "type": "string", "minLength": 1 }
      }
    },
    "objective": { "type": "string", "minLength": 10 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stateSha256", "governanceReportSha256", "sources"],
      "properties": {
        "status": { "enum": ["PROPOSED", "APPROVED"] },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "stateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "governanceReportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEvidence", "claimBoundary"],
      "properties": {
        "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "claimBoundary": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "estimateHours", "dependsOn", "owns", "acceptanceCriteria", "validate"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "estimateHours": { "type": "number", "exclusiveMinimum": 0 },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "owns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "validate": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "produces": { "type": "array", "items": { "$ref": "#/$defs/producedArtifact" } },
        "consumes": { "type": "array", "items": { "$ref": "#/$defs/consumedArtifact" } }
      }
    },
    "producedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "consumedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "artifact", "version"],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
